{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vienkartine",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "build": { "command": "bun run build" },
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/r/*", "/o/*", "/en/s/*", "/en/r/*", "/en/o/*", "/_app/*", "/en/_app/*", "/robots.txt"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOXES", "class_name": "SecretBox" },
      { "name": "LIMITS", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SecretBox", "RateLimiter"] }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "7101", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_FILL", "namespace_id": "7102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_OPEN", "namespace_id": "7103", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "7104", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "VERIFIED_NAME": "Operator",
    "INDEXABLE": "false",
    "RESERVED_LABEL_WORDS": ""
  },
  "observability": { "enabled": false }
}
